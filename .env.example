# Supabase Postgres connection.
# DATABASE_URL = pooled connection (PgBouncer, port 6543) — used by the running app.
# DIRECT_URL   = direct connection (port 5432) — used by `prisma migrate`.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"

# Supabase Storage (CV uploads, interview audio) — service role key, server-side only, never exposed to the client.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Custom JWT auth — generate strong random values, e.g. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Gemini (Google AI Studio free tier)
GOOGLE_AI_API_KEY=""
