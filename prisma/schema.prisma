// Prisma schema — see PLANNING.md section 4 for the design rationale.
// Note: KnowledgeSource's vector embedding column is added later (Phase 7) via a raw SQL
// migration against the pgvector extension — Prisma's schema language has no vector type.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CEFRLevel {
  NONE
  A1
  A2
  B1
  B2
  C1
  C2
}

enum TargetLocation {
  GERMANY
  ABROAD
  OPEN
}

enum TargetCompanyType {
  GERMAN_COMPANY
  INTERNATIONAL
  OPEN
}

enum CVStatus {
  DRAFT
  AI_REVIEWED
  FINALIZED
}

enum SourceType {
  OFFICIAL
  CANDIDATE_REPORTED
  EDITORIAL
}

enum LanguageRequirement {
  EXPLICIT
  PREFERRED
  NOT_EXPLICIT
  UNCLEAR
}

enum QuestionCategory {
  INTRODUCTION
  MOTIVATION
  WHY_GERMANY
  WHY_COMPANY
  WHY_ROLE
  EDUCATION
  EXPERIENCE
  INTERNSHIP
  STRENGTHS
  WEAKNESSES
  TEAMWORK
  CONFLICT
  LEADERSHIP
  FAILURE
  PRESSURE
  PROBLEM_SOLVING
  CAREER_GOALS
  RELOCATION
  WORK_AUTHORIZATION
  SALARY
  GERMAN_WORKPLACE_CULTURE
  QUESTIONS_FOR_INTERVIEWER
  SITUATIONAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewLanguage {
  DE
  EN
}

enum InterviewType {
  GENERAL
  GERMANY_FOCUSED
  COMPANY_FOCUSED
  JOB_FOCUSED
}

enum InterviewStatus {
  SETUP
  IN_PROGRESS
  COMPLETE
}

enum QuestionSource {
  BANK
  GENERATED_FOLLOWUP
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       CandidateProfile?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model CandidateProfile {
  id                      String            @id @default(cuid())
  userId                  String            @unique
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  currentCountry          String?
  degree                  String?
  university              String?
  germanLevel             CEFRLevel         @default(NONE)
  englishLevel            CEFRLevel         @default(NONE)
  targetLocation          TargetLocation    @default(OPEN)
  targetCompanyType       TargetCompanyType @default(OPEN)
  preferredCities         String[]          @default([])
  workAuthorizationStatus String?
  careerGoals             String?
  hobbies                 String[]          @default([])
  interests               String[]          @default([])

  experiences      Experience[]
  projects         ProjectEntry[]
  skills           SkillEntry[]
  cvs              CV[]
  coverLetters     CoverLetter[]
  interviews       Interview[]
  practiceSessions PracticeSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id           String           @id @default(cuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  role         String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  isInternship Boolean          @default(false)

  @@index([profileId])
}

model ProjectEntry {
  id           String           @id @default(cuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  technologies String[]         @default([])
  role         String?

  @@index([profileId])
}

model SkillEntry {
  id          String           @id @default(cuid())
  profileId   String
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  proficiency String?

  @@index([profileId])
}

model CV {
  id             String           @id @default(cuid())
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rawUploadUrl   String?
  structuredData Json?
  aiSuggestions  Json?
  status         CVStatus         @default(DRAFT)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([profileId])
}

model CoverLetter {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  content   String
  jobId     String?
  createdAt DateTime         @default(now())

  @@index([profileId])
}

model Company {
  id                 String    @id @default(cuid())
  name               String    @unique
  slug               String    @unique
  overview           String?
  germanyLocations   String[]  @default([])
  industries         String[]  @default([])
  values             String[]  @default([])
  hiringProcessNotes String?
  languageInfo       String?
  lastVerifiedAt     DateTime?

  knowledgeSources KnowledgeSource[]
  jobPostings      JobPosting[]
  interviews       Interview[]
}

model KnowledgeSource {
  id          String     @id @default(cuid())
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title       String
  url         String?
  sourceType  SourceType
  content     String
  retrievedAt DateTime

  @@index([companyId])
}

model JobPosting {
  id                 String              @id @default(cuid())
  profileId          String?
  companyId          String?
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyNameRaw     String?
  title              String
  location           String?
  rawDescription     String
  responsibilities   String[]            @default([])
  requiredSkills     String[]            @default([])
  preferredSkills    String[]            @default([])
  educationReq       String?
  experienceReq      String?
  germanRequirement  LanguageRequirement @default(UNCLEAR)
  englishRequirement LanguageRequirement @default(UNCLEAR)
  otherLanguageReq   String?
  visaInfoExtracted  String?
  potentialTopics    String[]            @default([])
  createdAt          DateTime            @default(now())

  interviews Interview[]

  @@index([companyId])
}

model InterviewQuestionBank {
  id                 String           @id @default(cuid())
  code               String?          @unique // human-readable reference, e.g. "Q001" — for seed idempotency and debugging
  textDe             String
  textEn             String
  category           QuestionCategory
  difficulty         Difficulty
  cefrRelevance      String?
  purpose            String? // what this question is meant to reveal — surfaced later in evaluation explanations
  followUpTopics     String[]         @default([])
  companyRelevance   String[]         @default([])
  roleRelevance      String[]         @default([])
  expectedCompetency String?
}

model Interview {
  id           String            @id @default(cuid())
  profileId    String
  profile      CandidateProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobPostingId String?
  jobPosting   JobPosting?       @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  language     InterviewLanguage
  difficulty   Difficulty
  type         InterviewType
  status       InterviewStatus   @default(SETUP)
  startedAt    DateTime?
  completedAt  DateTime?

  turns                 InterviewTurn[]
  claims                InterviewClaim[]
  languageAssessment    LanguageAssessment?
  performanceAssessment InterviewPerformanceAssessment?
  culturalAssessment    CulturalCommunicationAssessment?
  feedback              InterviewFeedback?

  @@index([profileId])
}

model InterviewTurn {
  id                       String            @id @default(cuid())
  interviewId              String
  interview                Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sequence                 Int
  questionText             String
  questionSource           QuestionSource
  category                 QuestionCategory? // for category-coverage tracking; null for generated follow-ups
  bankQuestionCode         String? // InterviewQuestionBank.code, when questionSource = BANK — excludes repeats
  parentTurnId             String?
  audioUrl                 String?
  transcript               String?
  transcriptWordTimestamps Json?
  answeredAt               DateTime?

  speechMetric SpeechMetric?

  @@index([interviewId])
}

model InterviewClaim {
  id                   String    @id @default(cuid())
  interviewId          String
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  turnId               String
  topic                String
  claimText            String
  firstMentionedTurnId String
  revisitedTurnIds     String[]  @default([])

  @@index([interviewId])
}

model SpeechMetric {
  id                  String        @id @default(cuid())
  turnId              String        @unique
  turn                InterviewTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  durationSec         Float
  speakingDurationSec Float
  wordsPerMinute      Float
  pauseCount          Int
  longPauseCount      Int
  fillerWordCount     Int
  fillerWords         String[]      @default([])
}

model LanguageAssessment {
  id                    String    @id @default(cuid())
  interviewId           String    @unique
  interview             Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  grammarScore          Int
  vocabularyScore       Int
  fluencyScore          Int
  comprehensionScore    Int
  professionalLangScore Int
  explanation           String
}

model InterviewPerformanceAssessment {
  id                    String    @id @default(cuid())
  interviewId           String    @unique
  interview             Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  relevanceScore        Int
  structureScore        Int
  motivationScore       Int
  professionalismScore  Int
  followUpHandlingScore Int
  explanation           String
}

model CulturalCommunicationAssessment {
  id                     String    @id @default(cuid())
  interviewId            String    @unique
  interview              Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  formalityScore         Int
  sieDuNotes             String?
  clarityScore           Int
  culturalAwarenessScore Int
  explanation            String
}

model InterviewFeedback {
  id               String    @id @default(cuid())
  interviewId      String    @unique
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  overallReadiness Int
  mainStrength     String
  mainWeakness     String
  recommendations  String[]  @default([])
  createdAt        DateTime  @default(now())
}

model PracticeSession {
  id                 String           @id @default(cuid())
  profileId          String
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  basedOnInterviewId String?
  focusArea          String
  items              Json
  completedAt        DateTime?
  createdAt          DateTime         @default(now())

  @@index([profileId])
}

model EditorialContent {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  body           String
  publishedAt    DateTime
  lastReviewedAt DateTime
}
