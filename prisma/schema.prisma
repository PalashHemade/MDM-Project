generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  passwordHash  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profile       CandidateProfile?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateProfile {
  id                      String            @id @default(cuid())
  userId                  String            @unique
  name                    String
  currentCountry          String?
  degree                  String?
  university              String?
  germanLevel             CEFRLevel         @default(NONE)
  englishLevel            CEFRLevel         @default(NONE)
  targetLocation          TargetLocation    @default(OPEN)
  targetCompanyType       TargetCompanyType @default(OPEN)
  preferredCities         String[]          @default([])
  workAuthorizationStatus String?
  careerGoals             String?
  hobbies                 String[]          @default([])
  interests               String[]          @default([])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  cvs                     CV[]
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverLetters            CoverLetter[]
  experiences             Experience[]
  interviews              Interview[]
  practiceSessions        PracticeSession[]
  projects                ProjectEntry[]
  skills                  SkillEntry[]
}

model Experience {
  id           String           @id @default(cuid())
  profileId    String
  company      String
  role         String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  isInternship Boolean          @default(false)
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ProjectEntry {
  id           String           @id @default(cuid())
  profileId    String
  title        String
  description  String?
  technologies String[]         @default([])
  role         String?
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SkillEntry {
  id          String           @id @default(cuid())
  profileId   String
  name        String
  category    String?
  proficiency String?
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CV {
  id             String           @id @default(cuid())
  profileId      String
  rawUploadUrl   String?
  structuredData Json?
  aiSuggestions  Json?
  status         CVStatus         @default(DRAFT)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model CoverLetter {
  id        String           @id @default(cuid())
  profileId String
  content   String
  jobId     String?
  createdAt DateTime         @default(now())
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Company {
  id                 String            @id @default(cuid())
  name               String            @unique
  slug               String            @unique
  overview           String?
  germanyLocations   String[]          @default([])
  industries         String[]          @default([])
  values             String[]          @default([])
  hiringProcessNotes String?
  languageInfo       String?
  lastVerifiedAt     DateTime?
  interviews         Interview[]
  jobPostings        JobPosting[]
  knowledgeSources   KnowledgeSource[]
}

model KnowledgeSource {
  id          String     @id @default(cuid())
  companyId   String?
  title       String
  url         String?
  sourceType  SourceType
  content     String
  retrievedAt DateTime
  company     Company?   @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model JobPosting {
  id                 String              @id @default(cuid())
  profileId          String?
  companyId          String?
  companyNameRaw     String?
  title              String
  location           String?
  rawDescription     String
  responsibilities   String[]            @default([])
  requiredSkills     String[]            @default([])
  preferredSkills    String[]            @default([])
  educationReq       String?
  experienceReq      String?
  germanRequirement  LanguageRequirement @default(UNCLEAR)
  englishRequirement LanguageRequirement @default(UNCLEAR)
  otherLanguageReq   String?
  visaInfoExtracted  String?
  potentialTopics    String[]            @default([])
  createdAt          DateTime            @default(now())
  interviews         Interview[]
  company            Company?            @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model InterviewQuestionBank {
  id                 String           @id @default(cuid())
  code               String?          @unique
  textDe             String
  textEn             String
  category           QuestionCategory
  difficulty         Difficulty
  cefrRelevance      String?
  purpose            String?
  followUpTopics     String[]         @default([])
  companyRelevance   String[]         @default([])
  roleRelevance      String[]         @default([])
  expectedCompetency String?
}

model Interview {
  id                    String                           @id @default(cuid())
  profileId             String
  jobPostingId          String?
  companyId             String?
  language              InterviewLanguage
  difficulty            Difficulty
  type                  InterviewType
  status                InterviewStatus                  @default(SETUP)
  startedAt             DateTime?
  completedAt           DateTime?
  culturalAssessment    CulturalCommunicationAssessment?
  company               Company?                         @relation(fields: [companyId], references: [id])
  jobPosting            JobPosting?                      @relation(fields: [jobPostingId], references: [id])
  profile               CandidateProfile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  claims                InterviewClaim[]
  feedback              InterviewFeedback?
  performanceAssessment InterviewPerformanceAssessment?
  turns                 InterviewTurn[]
  languageAssessment    LanguageAssessment?

  @@index([profileId])
}

model InterviewTurn {
  id                       String            @id @default(cuid())
  interviewId              String
  sequence                 Int
  questionText             String
  questionSource           QuestionSource
  parentTurnId             String?
  audioUrl                 String?
  transcript               String?
  transcriptWordTimestamps Json?
  answeredAt               DateTime?
  bankQuestionCode         String?
  category                 QuestionCategory?
  interview                Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  speechMetric             SpeechMetric?

  @@index([interviewId])
}

model InterviewClaim {
  id                   String    @id @default(cuid())
  interviewId          String
  turnId               String
  topic                String
  claimText            String
  firstMentionedTurnId String
  revisitedTurnIds     String[]  @default([])
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model SpeechMetric {
  id                  String        @id @default(cuid())
  turnId              String        @unique
  durationSec         Float
  speakingDurationSec Float
  wordsPerMinute      Float
  pauseCount          Int
  longPauseCount      Int
  fillerWordCount     Int
  fillerWords         String[]      @default([])
  turn                InterviewTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
}

model LanguageAssessment {
  id                    String    @id @default(cuid())
  interviewId           String    @unique
  grammarScore          Int
  vocabularyScore       Int
  fluencyScore          Int
  comprehensionScore    Int
  professionalLangScore Int
  explanation           String
  interview             Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model InterviewPerformanceAssessment {
  id                    String    @id @default(cuid())
  interviewId           String    @unique
  relevanceScore        Int
  structureScore        Int
  motivationScore       Int
  professionalismScore  Int
  followUpHandlingScore Int
  explanation           String
  interview             Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model CulturalCommunicationAssessment {
  id                     String    @id @default(cuid())
  interviewId            String    @unique
  formalityScore         Int
  sieDuNotes             String?
  clarityScore           Int
  culturalAwarenessScore Int
  explanation            String
  interview              Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model InterviewFeedback {
  id               String    @id @default(cuid())
  interviewId      String    @unique
  overallReadiness Int
  mainStrength     String
  mainWeakness     String
  recommendations  String[]  @default([])
  createdAt        DateTime  @default(now())
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id                 String           @id @default(cuid())
  profileId          String
  basedOnInterviewId String?
  focusArea          String
  items              Json
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model EditorialContent {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  body           String
  publishedAt    DateTime
  lastReviewedAt DateTime
}

enum CEFRLevel {
  NONE
  A1
  A2
  B1
  B2
  C1
  C2
}

enum TargetLocation {
  GERMANY
  ABROAD
  OPEN
}

enum TargetCompanyType {
  GERMAN_COMPANY
  INTERNATIONAL
  OPEN
}

enum CVStatus {
  DRAFT
  AI_REVIEWED
  FINALIZED
}

enum SourceType {
  OFFICIAL
  CANDIDATE_REPORTED
  EDITORIAL
}

enum LanguageRequirement {
  EXPLICIT
  PREFERRED
  NOT_EXPLICIT
  UNCLEAR
}

enum QuestionCategory {
  INTRODUCTION
  MOTIVATION
  WHY_GERMANY
  WHY_COMPANY
  WHY_ROLE
  EDUCATION
  EXPERIENCE
  INTERNSHIP
  STRENGTHS
  WEAKNESSES
  TEAMWORK
  CONFLICT
  LEADERSHIP
  FAILURE
  PRESSURE
  PROBLEM_SOLVING
  CAREER_GOALS
  RELOCATION
  WORK_AUTHORIZATION
  SALARY
  GERMAN_WORKPLACE_CULTURE
  QUESTIONS_FOR_INTERVIEWER
  SITUATIONAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InterviewLanguage {
  DE
  EN
}

enum InterviewType {
  GENERAL
  GERMANY_FOCUSED
  COMPANY_FOCUSED
  JOB_FOCUSED
}

enum InterviewStatus {
  SETUP
  IN_PROGRESS
  COMPLETE
}

enum QuestionSource {
  BANK
  GENERATED_FOLLOWUP
}
